# EduKraft - Variables d'environnement Expo (SDK 50)
# Copier ce fichier en `.env` pour le developpement local (Expo Go / web).
# Les variables EXPO_PUBLIC_* sont injectees au bundle par Expo.
# En build EAS, ce sont les valeurs de `eas.json` (profil preview/production)
# qui priment sur ce fichier.

# URL du backend (Render). En dev natif, on peut pointer vers un serveur local :
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
EXPO_PUBLIC_API_URL=https://edukraft-api.onrender.com

# Cle API attendue par le backend (X-API-Key)
EXPO_PUBLIC_API_KEY=dev-key

# Google OAuth - Client ID de type "Web application" (public, sans secret).
# Identique a celui configure dans Google Cloud Console.
# Redirect URIs a autoriser dans Google Cloud Console :
#   - https://auth.expo.io/@orion-k/edukraft   (proxy Expo Go / dev-client / APK)
#   - https://auth.expo.io                     (variante sans chemin, selon compte)
#   - (web uniquement) origine du serveur web, ex: http://localhost:8081
EXPO_PUBLIC_GOOGLE_CLIENT_ID=627774206464-ktg1e33crrdq398e6hiunvlg9pucf1j7.apps.googleusercontent.com

# Facebook OAuth - App ID (a creer sur developers.facebook.com).
# VIDE = bouton Facebook MASQUE proprement dans l'app (aucune alerte,
#        aucun crash). Il reaparaitra automatiquement des que l'App ID
#        sera renseigne ici ou dans eas.json.
# Redirect URI a autoriser : https://auth.expo.io/@orion-k/edukraft
EXPO_PUBLIC_FACEBOOK_APP_ID=

# OTP telephone (true/false)
EXPO_PUBLIC_PHONE_OTP_ENABLED=true

# ── v1.1.21 (Phase 3) — Observabilité ─────────────────────────────────────
# Error reporting (Sentry). Format: https://<publickey>@o<orgid>.ingest.sentry.io/<projectid>
# VIDE = error reporting désactivé (no-op, console.warn uniquement).
# Créer un projet sur https://sentry.io (free tier 5k events/mois) et copier le DSN.
EXPO_PUBLIC_SENTRY_DSN=

# Analytics d'apprentissage (PostHog/Mixpanel/Amplitude).
# VIDE = analytics en console (dev) / no-op (prod).
# Provider supportés : 'posthog' | 'mixpanel' | 'amplitude' | 'custom'
# - posthog : API key + (optionnel) host (défaut app.posthog.com)
# - mixpanel : token
# - amplitude : API key
# - custom : POST vers EXPO_PUBLIC_ANALYTICS_HOST
EXPO_PUBLIC_ANALYTICS_PROVIDER=
EXPO_PUBLIC_ANALYTICS_KEY=
EXPO_PUBLIC_ANALYTICS_HOST=

