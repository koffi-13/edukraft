# EduKraft API v2.0 — Variables d'environnement (Phase 3)
# Copier en .env et remplir les valeurs de production

# ── Serveur ─────────────────────────────────────────────────────────────
PORT=3001
API_KEY=change-me-in-production
PUBLIC_URL=https://api.edukraft.tg

# ── Base de données SQLite ──────────────────────────────────────────────
DB_PATH=./data/edukraft.db

# ── CORS origins (séparées par des virgules) ────────────────────────────
CORS_ORIGINS=exp://localhost:1902,https://edukraft.web.app

# ── Blockchain Polygon PoS (Phase 3) ────────────────────────────────────
# Mode mock par défaut (pas de vraies transactions)
POLYGON_MOCK_MODE=true
POLYGON_NETWORK=amoy              # amoy (testnet) | mainnet
POLYGON_RPC_URL=                  # Laisser vide pour utiliser le RPC public par défaut
POLYGON_CONTRACT_ADDRESS=         # Adresse du contrat déployé
POLYGON_PRIVATE_KEY=              # Clé privée du minter (NE JAMAIS COMMITTER)

# ── Paiements mobiles T-Money / Flooz (Phase 3) ────────────────────────
# Mode mock par défaut (simulation de confirmation après 3s)
PAYMENT_MOCK=true
PAYMENT_WEBHOOK_SECRET=change-me-in-production

# T-Money API
TMONEY_API_URL=https://api.tmoney.tg/v2
TMONEY_MERCHANT_ID=
TMONEY_API_KEY=
TMONEY_API_SECRET=

# Flooz (Payzone) API
FLOOZ_API_URL=https://api.payzone.tg/v1
FLOOZ_MERCHANT_ID=
FLOOZ_API_KEY=
FLOOZ_API_SECRET=
