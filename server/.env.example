# ═══════════════════════════════════════════════════════════════════════════════
# EduKraft API — Exemple de configuration environnement
# ═══════════════════════════════════════════════════════════════════════════════
# Copier ce fichier en .env et remplir les valeurs.
#   cp .env.example .env
#
# ⚠️ NE JAMAIS committer le fichier .env (il est dans .gitignore).

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3001
# Origines CORS autorisées (séparées par des virgules, ou * pour tout autoriser)
CORS_ORIGINS=*
# Chemin de la base SQLite (relatif au dossier server/)
DB_PATH=./data/edukraft.db

# ── Sécurité API ─────────────────────────────────────────────────────────────
# Clé API pour les endpoints de sync (header x-api-key). À remplacer en prod.
API_KEY=dev-key

# ── URL publique (pour les callbacks de paiement) ────────────────────────────
PUBLIC_URL=https://api.edukraft.tg

# ═══════════════════════════════════════════════════════════════════════════════
# AUTHENTIFICATION (Phase 1)
# ═══════════════════════════════════════════════════════════════════════════════

# ── JWT ──────────────────────────────────────────────────────────────────────
# ⚠️ OBLIGATOIRE en production : générer avec `openssl rand -hex 32`
# Sans cette variable, un secret aléatoire est régénéré à chaque redémarrage,
# ce qui invalide tous les tokens existants.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRES=7d
REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=10

# ── Google OAuth ─────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Créer un credential OAuth 2.0 (Web application).
# Redirect URI autorisé : https://auth.expo.io/@<expo-username>/edukraft
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=    # Optionnel (flux code-only)

# ── Apple Sign-In ────────────────────────────────────────────────────────────
# https://developer.apple.com/account/resources/identifiers/list
# Nécessite un compte développeur Apple payant ($99/an).
APPLE_BUNDLE_ID=com.edukraft.app

# ── Facebook OAuth ───────────────────────────────────────────────────────────
# https://developers.facebook.com/apps/
# Créer une app, configurer Facebook Login.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=      # Optionnel

# ── Phone OTP (SMS) ──────────────────────────────────────────────────────────
# En mode dev : OTP_MOCK_CODE=123456 → le code fixe 123456 est accepté
#               et affiché dans les logs serveur (pas de SMS réel envoyé).
# En prod : décommenter les variables Twilio (ou Vonage / provider local).
PHONE_OTP_ENABLED=true
OTP_MOCK_CODE=123456
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ═══════════════════════════════════════════════════════════════════════════════
# BLOCKCHAIN (Phase 3) — Certification badges sur Polygon
# ═══════════════════════════════════════════════════════════════════════════════

# Mock mode : si "false", mint réel sur Polygon (nécessite PRIVATE_KEY + RPC).
POLYGON_MOCK_MODE=true
POLYGON_NETWORK=amoy
POLYGON_CHAIN_ID=80002
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CONTRACT_ADDRESS=
POLYGON_PRIVATE_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# PAIEMENTS MOBILE (Phase 3) — T-Money / Flooz
# ═══════════════════════════════════════════════════════════════════════════════

# Mock mode : si "false", appels réels aux APIs opérateur.
PAYMENT_MOCK=true
PAYMENT_WEBHOOK_SECRET=edukraft-webhook-secret-change-me

# T-Money (Togo Telecom)
TMONEY_API_URL=https://api.tmoney.tg/v2
TMONEY_MERCHANT_ID=
TMONEY_API_KEY=
TMONEY_API_SECRET=

# Flooz (Moov Africa)
FLOOZ_API_URL=https://api.payzone.tg/v1
FLOOZ_MERCHANT_ID=
FLOOZ_API_KEY=
FLOOZ_API_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
# VARIABLES CLIENT (app.json → extra / EXPO_PUBLIC_*)
# ═══════════════════════════════════════════════════════════════════════════════
# Ces variables sont exposées côté client via EAS env vars (préfixe EXPO_PUBLIC_).
# Elles NE DOIVENT PAS contenir de secrets (visibles dans le bundle client).
# ⚠️ API_URL doit pointer vers l'ORIGINE du serveur (sans suffixe /v1 ni /api) —
#    les appelants ajoutent eux-mêmes /api/... (ex: /api/sync, /api/auth/login).
#
# EXPO_PUBLIC_API_URL=https://api.edukraft.tg
# EXPO_PUBLIC_API_KEY=dev-key
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# EXPO_PUBLIC_FACEBOOK_APP_ID=
# EXPO_PUBLIC_PHONE_OTP_ENABLED=true
