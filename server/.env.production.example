# ── Production : backend EduKraft ────────────────────────────────────────────
# Copier ce fichier en .env sur l'hébergeur (Fly.io / Render / VPS).
# ⚠️ NE JAMAIS committer le vrai .env avec des secrets.

# Serveur
PORT=3001
CORS_ORIGINS=*
DB_PATH=/data/edukraft.db

# Sécurité — GÉNÉRER avec : openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_EXPIRES=7d
REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=10
API_KEY=REPLACE_WITH_GENERATED_KEY

# URL publique (sera l'URL Fly.io ou votre domaine)
PUBLIC_URL=https://edukraft-api.fly.dev

# ── OAuth (tous gratuits à configurer) ───────────────────────────────────────
# Google : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Apple : nécessite compte développeur $99/an — skip pour v1
APPLE_BUNDLE_ID=com.edukraft.app

# Facebook : https://developers.facebook.com/apps/
FACEBOOK_APP_ID=

# ── Phone OTP ────────────────────────────────────────────────────────────────
# En v1 gratuite : garder le mode mock (OTP_MOCK_CODE=123456)
# L'utilisateur reçoit le code dans les logs serveur ou on l'affiche côté client
# Pour de vrai SMS : Twilio ($15 crédit gratuit) ou Vonage
PHONE_OTP_ENABLED=true
OTP_MOCK_CODE=123456
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Blockchain (Polygon Amoy testnet — gratuit) ──────────────────────────────
POLYGON_MOCK_MODE=false
POLYGON_NETWORK=amoy
POLYGON_CONTRACT_ADDRESS=
POLYGON_PRIVATE_KEY=
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology

# ── Paiements (mock en v1 gratuite) ──────────────────────────────────────────
PAYMENT_MOCK=true
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_GENERATED_WEBHOOK_SECRET
