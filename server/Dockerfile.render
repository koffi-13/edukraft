# Dockerfile pour Render.com
# Render utilise Root Directory = server/, donc le build context est server/.
FROM node:20-slim
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --omit=dev --legacy-peer-deps
COPY index.js auth.js gamification.js payments.js blockchain.js ./
RUN mkdir -p /data
EXPOSE 3001
ENV PORT=3001
ENV DB_PATH=/data/edukraft.db
ENV NODE_ENV=production
ENV CORS_ORIGINS=*
CMD ["node", "index.js"]
